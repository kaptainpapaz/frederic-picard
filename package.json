    "next-intl": "^4.13.6",
    "nodemailer": "^10.1.2",
    "pg": "^8.16.3",
    "prisma": "^7.9.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.65.0",
    "sharp": "^0.35.5",
