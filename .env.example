# ---------------------------------------------------------------------------
# Règle B5 : DEUX catégories de variables, jamais interchangeables.
#   NEXT_PUBLIC_*  -> inlinées dans le bundle AU BUILD.
#   les autres     -> lues au DÉMARRAGE du conteneur.
# ---------------------------------------------------------------------------

PROJECT_NAME=frederic-picard
DOMAIN=photo.florianracine.com
LETSENCRYPT_EMAIL=contact@florianracine.com

# Base
POSTGRES_USER=app
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=fp
# En local seulement ; en production le compose construit l'URL vers le service db.
DATABASE_URL=postgresql://app:change-moi@localhost:5432/fp

# Auth — règle E1 : les TROIS réglages ou rien. Recette : se déconnecter, pas seulement se connecter.
AUTH_URL=https://photo.florianracine.com
AUTH_TRUST_HOST=true
# 32 caractères minimum. Signe le cookie de session (src/lib/auth-slot.ts).
AUTH_SECRET=change-moi

# Compte administrateur initial. Lu par le seed idempotent. Le mot de passe n'est posé
# que si le compte n'a pas encore de mot de passe ; Fred le change ensuite dans l'admin.
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Email — fournisseur = détail de configuration (arbitrage n°6). `log` écrit dans la console.
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Dossier des fichiers téléversés. En production : le volume /app/uploads (règle G1).
UPLOADS_DIR=./uploads

# Publique, figée au build.
NEXT_PUBLIC_SITE_URL=https://photo.florianracine.com
